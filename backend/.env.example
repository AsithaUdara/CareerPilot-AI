# PostgreSQL connection for CareerPilot AI
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGEME
POSTGRES_DB=careerpilot

# Full SQLAlchemy URL (overrides the POSTGRES_* pieces when set)
DATABASE_URL=postgresql+psycopg2://postgres:CHANGE_ME@127.0.0.1:5432/careerpilot

# Celery event-driven pipeline
CELERY_BROKER_URL=sqla+sqlite:///./celery_broker.sqlite
CELERY_RESULT_BACKEND=db+sqlite:///./celery_results.sqlite
CELERY_TASK_ALWAYS_EAGER=0
CELERY_USE_THREAD_FALLBACK=1

# Comma-separated frontend origins for CORS (add your deployed UI URL in production)
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
