# PostgreSQL connection for CareerPilot AI
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGEME
POSTGRES_DB=careerpilot

# Full SQLAlchemy URL (overrides the POSTGRES_* pieces when set)
DATABASE_URL=postgresql+psycopg2://postgres:CHANGE_ME@127.0.0.1:5432/careerpilot

# Google Gemini (required for real agents — get a key from Google AI Studio)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# Adzuna live job search (optional; curated real JDs used as fallback)
# Register at https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=gb
ADZUNA_RESULTS_PER_PAGE=8

# Persistent local Qdrant path (not :memory:)
QDRANT_PATH=./qdrant_data

# Tests only — never enable in production demos
CAREERPILOT_USE_STUB_LLM=0

# Celery event-driven pipeline
CELERY_BROKER_URL=sqla+sqlite:///./celery_broker.sqlite
CELERY_RESULT_BACKEND=db+sqlite:///./celery_results.sqlite
CELERY_TASK_ALWAYS_EAGER=0
CELERY_USE_THREAD_FALLBACK=1

# Comma-separated frontend origins for CORS (add your deployed UI URL in production)
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Google Sign-In (OAuth Web client ID — separate from Gemini GOOGLE_API_KEY)
GOOGLE_OAUTH_CLIENT_ID=
JWT_SECRET=change-me-in-production
JWT_EXPIRE_HOURS=168
# Set to 1 for local/dev/tests without Google Sign-In (candidate routes stay open)
AUTH_DISABLED=1

# Local Windows only: set to 0 if Gemini fails with CERTIFICATE_VERIFY_FAILED
SSL_VERIFY=1
